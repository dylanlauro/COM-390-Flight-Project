<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RegressionConsole</RootNamespace>
    <StartupObject>RegressionConsole.RegressionExample</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\RegressionExample.vb" Link="RegressionExample.vb" />
    <Import Include="System" />
  </ItemGroup>
</Project>
